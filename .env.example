# 同程/艺龙开放平台商务账号。不要把真实密钥提交到代码仓库。
TONGCHENG_USER=Agent_xxx
TONGCHENG_APP_KEY=replace_me
TONGCHENG_SECRET_KEY=replace_me

# 可选。由同程商务提供行程级 H5 深链模板后配置。
# 支持占位符：{origin} {destination} {departureDate} {returnDate} {adults}
TONGCHENG_DEEP_LINK_TEMPLATE=

# 可选。默认生产地址为 https://api.elong.com/rest
TONGCHENG_API_BASE=https://api.elong.com/rest
HOST=127.0.0.1
PORT=4173
